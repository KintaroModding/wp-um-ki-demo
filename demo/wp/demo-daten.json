{
  "seite": {
    "titel": "Who Is Who im eLearning",
    "untertitel": "Demo: Anbieter- und Freelancer-Verzeichnis mit Ultimate Member"
  },

  "felder": {
    "user_email":     { "typ": "email",    "label": "E-Mail", "pflicht": true },
    "user_password":  { "typ": "password", "label": "Passwort", "pflicht": true },
    "kontotyp":       { "typ": "radio",    "label": "Kontotyp", "pflicht": true,
                        "optionen": ["eLearning Dienstleister", "Freelancer", "Hochschule"] },
    "profil_sprache": { "typ": "checkbox", "label": "Sprache des Profils", "pflicht": true,
                        "optionen": ["Deutsch", "Englisch", "Französisch"] },
    "profil_typ":     { "typ": "radio",    "label": "Profil", "pflicht": true,
                        "optionen": ["Basis-Profil", "Premium-Profil", "Partner-Profil"],
                        "hilfe": "Premium-Profile erscheinen mit Logo und ausführlicher Beschreibung." },
    "unternehmen":    { "typ": "text",     "label": "Unternehmensname", "pflicht": true },
    "ort":            { "typ": "text",     "label": "Ort" },
    "webseite":       { "typ": "url",      "label": "Webseite" },
    "beschreibung":   { "typ": "textarea", "label": "Kurzbeschreibung" },
    "datenschutz":    { "typ": "checkbox", "label": "Datenschutz", "pflicht": true,
                        "optionen": ["Ich habe die Datenschutzerklärung gelesen und willige ein."] },
    "agb":            { "typ": "checkbox", "label": "AGB", "pflicht": true,
                        "optionen": ["Ich habe die AGB gelesen und willige ein."] }
  },

  "registrierung": [
    "user_email", "user_password", "kontotyp", "profil_sprache", "profil_typ",
    "unternehmen", "datenschutz", "agb"
  ],

  "profil": [
    "unternehmen", "kontotyp", "profil_sprache", "ort", "webseite", "beschreibung"
  ],

  "rollen": [
    { "key": "basis",   "name": "Basis-Profil",   "nach_registrierung": "/who-is-who/" },
    { "key": "premium", "name": "Premium-Profil", "nach_registrierung": "/who-is-who/" },
    { "key": "partner", "name": "Partner-Profil", "nach_registrierung": "/who-is-who/" }
  ],

  "rolle_nach_profil": {
    "Basis-Profil": "basis",
    "Premium-Profil": "premium",
    "Partner-Profil": "partner"
  },

  "verzeichnis": {
    "titel": "Who Is Who",
    "sichtbar_fuer": "mitglieder",
    "filter": ["kontotyp", "profil_sprache", "profil_typ", "ort"],
    "unter_dem_namen": ["kontotyp"],
    "details": ["ort", "profil_sprache", "beschreibung"],
    "pro_seite": 12
  },

